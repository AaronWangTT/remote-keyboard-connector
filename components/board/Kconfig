menu "Board controls"

choice BOARD_STATUS_PROFILE
    prompt "Board profile"
    default BOARD_STATUS_LED_DISABLED

config BOARD_STATUS_LED_DISABLED
    bool "Disabled / unspecified board (leave GPIO untouched)"

config BOARD_XINLUCITY_ESP32S3_NANO
    bool "XinluCity ESP32S3 NANO / ESP32-S3-N16R8 (G48 active-low)"
    depends on IDF_TARGET_ESP32S3
    help
        Select only for the documented single-color G48 circuit on this
        board. GPIO48 LOW illuminates the LED; HIGH turns it off.
        This does not control PWR or configure flash/PSRAM capacity.

config BOARD_SEEED_XIAO_ESP32S3
    bool "Seeed Studio XIAO ESP32S3 (8 MiB flash)"
    depends on IDF_TARGET_ESP32S3
    help
        Select only for the standard XIAO ESP32S3, not the 16 MiB Plus.
        Use the tracked XIAO defaults overlay for its flash and OTA layout.
        The GPIO21 user LED is active-low. Automatic deep sleep is available
        with GPIO0 BOOT wake but defaults to Never until the owner opts in.
        The battery-charge LED is independent and is not software-controlled.

endchoice

config BOARD_POWER_MANAGEMENT
    bool "Automatic deep sleep with BOOT wake"
    depends on (BOARD_XINLUCITY_ESP32S3_NANO || BOARD_SEEED_XIAO_ESP32S3) && IDF_TARGET_ESP32S3
    default y
    help
        Enable GPIO0 BOOT wake on the selected board. The status LED stays off
        during sleep. Both boards default to Never until the owner opts in.
        The owner can save 30 minutes, 60 minutes, or Never on either board.
        Fixed power/charge indicators remain independent.
        Physical power, USB reconnection and wake acceptance are still required.

endmenu